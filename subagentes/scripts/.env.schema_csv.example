# ============================================================================
# DISEÑADOR DE SCHEMA CSV CONFIGURATION
# ============================================================================
# Este archivo contiene las variables de entorno para el script
# schema_csv_designer.py
#
# INSTRUCCIONES:
# 1. Copia este archivo como .env en el mismo directorio
# 2. Configura tu OPENAI_API_KEY
# 3. Crea una subcarpeta para tus archivos CSV
# 4. Ajusta CSV_DIR para apuntar a esa subcarpeta
# 5. Ejecuta: python scripts/schema_csv_designer.py

# ============================================================================
# OPENAI CONFIGURATION
# ============================================================================

# Tu API Key de OpenAI (REQUERIDO)
# Obtén tu key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Modelo de lenguaje para diseñar el schema
# Opciones:
#   - gpt-4-turbo (Recomendado: Mejor balance calidad/precio)
#   - gpt-4 (Máxima calidad, más costoso)
#   - gpt-3.5-turbo (Más económico, menor precisión en schemas complejos)
LLM_MODEL=gpt-4-turbo


# ============================================================================
# CSV FILES CONFIGURATION
# ============================================================================

# IMPORTANTE: Directorio/subcarpeta donde están los archivos CSV
# Este directorio debe contener TODOS los CSVs que quieres analizar
#
# Estructura recomendada:
#   proyecto/
#   ├── csv_data/              ← Esta subcarpeta
#   │   ├── products.csv
#   │   ├── suppliers.csv
#   │   ├── customers.csv
#   │   └── orders.csv
#   ├── scripts/
#   │   ├── schema_csv_designer.py
#   │   └── .env
#   └── resultados/
#
# Puede ser ruta relativa o absoluta
# Relativa: ./csv_data/ (desde donde ejecutas el script)
# Absoluta: /home/user/proyecto/csv_data/
CSV_DIR=./csv_data/

# Nota: NO incluir rutas de archivos individuales aquí
# El script descubrirá automáticamente todos los .csv en CSV_DIR


# ============================================================================
# OBJETIVO DEL SCHEMA
# ============================================================================

# Ruta al archivo de objetivo validado
# Generado por agente_objetivo_schema
# Si no existe, el script usará un objetivo por defecto
OBJETIVO_PATH=resultados/objetivo_validado.md


# ============================================================================
# OUTPUT CONFIGURATION
# ============================================================================

# Directorio donde se guardarán los resultados
# Se crearán los archivos:
#   - schema_csv_validado.json (schema en JSON)
#   - schema_csv_validado.md (schema en Markdown)
OUTPUT_DIR=resultados/


# ============================================================================
# ADVANCED CONFIGURATION (OPCIONAL)
# ============================================================================

# Máximo de filas a leer de cada CSV para análisis
# Valores más altos = mejor análisis, más lento
# CSV_SAMPLE_ROWS=5

# Encoding de los CSVs
# Por defecto: utf-8
# Otras opciones: latin1, iso-8859-1, cp1252
# CSV_ENCODING=utf-8

# Separador de CSVs
# Por defecto: coma (,)
# Otras opciones: ; (punto y coma), \t (tab)
# CSV_SEPARATOR=,


# ============================================================================
# EJEMPLOS DE CONFIGURACIÓN
# ============================================================================

# --- Ejemplo 1: Configuración básica local ---
# OPENAI_API_KEY=sk-abc123...
# LLM_MODEL=gpt-4-turbo
# CSV_DIR=./csv_data/
# OBJETIVO_PATH=resultados/objetivo_validado.md
# OUTPUT_DIR=resultados/

# --- Ejemplo 2: CSVs en ubicación personalizada ---
# OPENAI_API_KEY=sk-abc123...
# LLM_MODEL=gpt-4-turbo
# CSV_DIR=/home/usuario/datos/vuelco_bd_produccion/
# OBJETIVO_PATH=resultados/objetivo_validado.md
# OUTPUT_DIR=resultados/

# --- Ejemplo 3: CSVs con encoding especial ---
# OPENAI_API_KEY=sk-abc123...
# LLM_MODEL=gpt-4-turbo
# CSV_DIR=./csv_data/
# CSV_ENCODING=latin1
# CSV_SEPARATOR=;

# --- Ejemplo 4: Economizar costos con GPT-3.5 ---
# OPENAI_API_KEY=sk-abc123...
# LLM_MODEL=gpt-3.5-turbo
# CSV_DIR=./csv_data/
# OBJETIVO_PATH=resultados/objetivo_validado.md
# OUTPUT_DIR=resultados/


# ============================================================================
# PREPARACIÓN DE CSVs
# ============================================================================

# Antes de ejecutar el script, asegúrate de:
#
# 1. CREAR la subcarpeta de CSVs:
#    mkdir csv_data
#
# 2. COPIAR tus archivos CSV a la subcarpeta:
#    cp /ruta/origen/*.csv csv_data/
#
# 3. VERIFICAR que los CSVs estén ahí:
#    ls csv_data/
#
#    Deberías ver algo como:
#    csv_data/
#    ├── products.csv
#    ├── suppliers.csv
#    └── customers.csv
#
# 4. VERIFICAR el formato de los CSVs:
#    - Encoding: UTF-8 (recomendado)
#    - Separador: coma (,)
#    - Header: Primera fila con nombres de columnas
#    - Sin filas vacías al inicio
#
# 5. (OPCIONAL) Verificar que se lean correctamente:
#    python -c "import pandas as pd; print(pd.read_csv('csv_data/tu_archivo.csv', nrows=2))"


# ============================================================================
# ESTRUCTURA DE NOMBRES EN CSVs
# ============================================================================

# Para mejores resultados, usa nombres descriptivos en tus CSVs:
#
# ARCHIVOS:
#   ✅ products.csv, customers.csv, orders.csv
#   ❌ export_2024.csv, data.csv, temp.csv
#
# COLUMNAS PRIMARY KEY:
#   ✅ product_id, customer_id, order_id
#   ❌ id, pk, key
#
# COLUMNAS FOREIGN KEY:
#   ✅ supplier_id (referencia a suppliers.csv)
#   ✅ customer_id (referencia a customers.csv)
#   ❌ fk, ref, parent_id


# ============================================================================
# NOTAS IMPORTANTES
# ============================================================================

# 1. CSV_DIR debe apuntar a una SUBCARPETA, no a archivos individuales
#    ✅ CSV_DIR=./csv_data/
#    ❌ CSV_DIR=./csv_data/products.csv

# 2. El script descubrirá TODOS los archivos .csv en CSV_DIR automáticamente
#    No necesitas listar los archivos manualmente

# 3. Los CSVs deben estar en formato válido:
#    - Primera fila con headers (nombres de columnas)
#    - Separador consistente (por defecto: coma)
#    - Encoding consistente (por defecto: UTF-8)

# 4. El script lee solo las primeras filas para análisis (por defecto: 5)
#    Esto es suficiente para detectar estructura y tipos de datos

# 5. Si no existe objetivo_validado.md, el script usa un objetivo genérico
#    Recomendación: Ejecutar primero agente_objetivo_schema

# 6. El schema generado se guardará en OUTPUT_DIR
#    Asegúrate de que el directorio exista o el script lo creará

# 7. Costos estimados por ejecución:
#    - GPT-4-turbo: ~$0.05-0.15 USD
#    - GPT-3.5-turbo: ~$0.005-0.015 USD
