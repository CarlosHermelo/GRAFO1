# ============================================================================
# GRAPHRAG ASSISTANT CONFIGURATION
# ============================================================================
# Este archivo contiene las variables de entorno para el asistente GraphRAG
#
# INSTRUCCIONES:
# 1. Copia este archivo como .env en el mismo directorio
# 2. Configura tu OPENAI_API_KEY
# 3. Ajusta las credenciales de Neo4j
# 4. Verifica las rutas a la BD vectorial
# 5. Ejecuta: python scripts/graphrag_assistant.py

# ============================================================================
# OPENAI CONFIGURATION
# ============================================================================

# Tu API Key de OpenAI (REQUERIDO)
# Obtén tu key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Modelo de lenguaje para generar respuestas
# Opciones:
#   - gpt-4 (Recomendado: Mayor calidad, más costoso)
#   - gpt-4-turbo (Rápido y económico)
#   - gpt-3.5-turbo (Más económico, menor calidad)
LLM_MODEL=gpt-4

# Modelo de embeddings (debe ser el MISMO que usaste en vectorial_builder.py)
# Opciones:
#   - text-embedding-3-small (Recomendado: Rápido y económico)
#   - text-embedding-3-large (Mayor precisión, más costoso)
EMBEDDING_MODEL=text-embedding-3-small


# ============================================================================
# VECTOR DATABASE CONFIGURATION
# ============================================================================

# Ruta donde está almacenada la BD vectorial
# Debe coincidir con la ruta usada en vectorial_builder.py
VECTOR_DB_PATH=./chroma_db/

# Nombre de la colección vectorial
# Debe coincidir con el nombre usado en vectorial_builder.py
VECTOR_DB_NAME=protesis_pami_vectordb


# ============================================================================
# NEO4J GRAPH DATABASE CONFIGURATION
# ============================================================================

# URI de conexión a Neo4j
# Opciones:
#   - bolt://localhost:7687 (Neo4j local)
#   - neo4j://localhost:7687 (Neo4j 4.x+)
#   - bolt://tu-servidor.com:7687 (Neo4j remoto)
NEO4J_URI=bolt://localhost:7687

# Usuario de Neo4j (por defecto: neo4j)
NEO4J_USER=neo4j

# Contraseña de Neo4j (REQUERIDO)
# Configura la que usaste al crear la base de datos
NEO4J_PASSWORD=your-neo4j-password


# ============================================================================
# GRAPHRAG STRATEGY CONFIGURATION
# ============================================================================

# Estrategia de consulta por defecto
# Opciones:
#   - auto (Recomendado: Detecta automáticamente según la pregunta)
#   - semantic_first (Siempre empieza por búsqueda vectorial)
#   - graph_first (Siempre empieza por búsqueda en grafo)
#   - hybrid (Ejecuta ambas en paralelo y combina scores)
GRAPHRAG_STRATEGY=auto

# Top-K resultados de búsqueda vectorial
# Cantidad de chunks más relevantes a recuperar de la BD vectorial
# Valores típicos: 5-15
TOP_K_VECTORS=10

# Top-K resultados de búsqueda en grafo
# Cantidad de nodos más relevantes a recuperar de Neo4j
# Valores típicos: 5-15
TOP_K_GRAPH=10

# Peso de la similitud semántica en el ranking híbrido (0.0 - 1.0)
# Mayor valor = prioriza similitud vectorial
# Valores típicos: 0.6-0.8
SEMANTIC_WEIGHT=0.7

# Peso de las señales del grafo en el ranking híbrido (0.0 - 1.0)
# Mayor valor = prioriza estructura del grafo
# Valores típicos: 0.2-0.4
# Nota: SEMANTIC_WEIGHT + GRAPH_WEIGHT debe sumar <= 1.0
GRAPH_WEIGHT=0.3

# Longitud máxima de paths a buscar en el grafo
# Valores más altos encuentran más conexiones pero son más lentos
# Valores típicos: 3-6
MAX_PATH_LENGTH=5


# ============================================================================
# ADVANCED CONFIGURATION (OPCIONAL)
# ============================================================================

# Habilitar modo verbose (más logs de debug)
# VERBOSE=false

# Timeout para consultas a Neo4j en segundos
# NEO4J_TIMEOUT=30

# Tamaño del contexto máximo para el LLM (en caracteres)
# MAX_CONTEXT_LENGTH=8000

# Habilitar caché de consultas
# ENABLE_CACHE=true


# ============================================================================
# EJEMPLOS DE CONFIGURACIÓN
# ============================================================================

# --- Ejemplo 1: Configuración local básica ---
# OPENAI_API_KEY=sk-abc123...
# LLM_MODEL=gpt-4
# EMBEDDING_MODEL=text-embedding-3-small
# VECTOR_DB_PATH=./chroma_db/
# VECTOR_DB_NAME=protesis_pami_vectordb
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=tu-password
# GRAPHRAG_STRATEGY=auto

# --- Ejemplo 2: Optimizado para velocidad y bajo costo ---
# OPENAI_API_KEY=sk-abc123...
# LLM_MODEL=gpt-3.5-turbo
# EMBEDDING_MODEL=text-embedding-3-small
# TOP_K_VECTORS=5
# TOP_K_GRAPH=5
# GRAPHRAG_STRATEGY=semantic_first

# --- Ejemplo 3: Máxima calidad (mayor costo) ---
# OPENAI_API_KEY=sk-abc123...
# LLM_MODEL=gpt-4
# EMBEDDING_MODEL=text-embedding-3-large
# TOP_K_VECTORS=15
# TOP_K_GRAPH=15
# GRAPHRAG_STRATEGY=hybrid
# SEMANTIC_WEIGHT=0.6
# GRAPH_WEIGHT=0.4

# --- Ejemplo 4: Priorizar estructura del grafo ---
# OPENAI_API_KEY=sk-abc123...
# LLM_MODEL=gpt-4
# GRAPHRAG_STRATEGY=graph_first
# SEMANTIC_WEIGHT=0.4
# GRAPH_WEIGHT=0.6


# ============================================================================
# NOTAS IMPORTANTES
# ============================================================================

# 1. El EMBEDDING_MODEL debe ser el MISMO que usaste para crear la BD vectorial
#    Si usaste text-embedding-3-small en vectorial_builder.py, usa el mismo aquí

# 2. Verifica que Neo4j esté ejecutándose antes de usar el asistente
#    Prueba: http://localhost:7474 en tu navegador

# 3. La BD vectorial debe existir antes de ejecutar el asistente
#    Si no existe, ejecuta primero: python scripts/vectorial_builder.py

# 4. Para usar la estrategia de "Comunidades + Resúmenes" necesitas pre-procesar
#    el grafo con algoritmos de clustering. Ejecuta:
#    python scripts/graph_preprocessing.py (cuando esté disponible)

# 5. Los pesos SEMANTIC_WEIGHT y GRAPH_WEIGHT deben sumar <= 1.0
#    El resto se puede asignar a otras señales (evidencia, autoridad, etc.)
