# ============================================================================
# Configuración para el Módulo de Carga CSV a Neo4j
# ============================================================================
#
# INSTRUCCIONES:
# 1. Copia este archivo a .env en el mismo directorio
# 2. Modifica los valores según tu entorno
# 3. NUNCA comitees el archivo .env con credenciales reales
#
# COMANDO:
#   cp .env.csv_loader.example .env
#   nano .env
#
# ============================================================================

# ============================================================================
# CONEXIÓN A NEO4J
# ============================================================================

# URI de conexión a Neo4j
# Formatos:
#   - Local: bolt://localhost:7687
#   - Remoto: bolt://192.168.1.100:7687
#   - Neo4j Aura: neo4j+s://xxxxx.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687

# Usuario de Neo4j (por defecto es 'neo4j')
NEO4J_USER=neo4j

# Contraseña de Neo4j
# IMPORTANTE: Cambia esto por tu contraseña real
NEO4J_PASSWORD=your_password_here

# ============================================================================
# RUTAS DE ARCHIVOS
# ============================================================================

# Directorio que contiene los archivos CSV
# Ruta relativa desde el directorio del script
# Los CSVs deben estar en esta carpeta con los nombres especificados en el schema
CSV_DIR=../csv_data/

# Ruta al schema validado generado por agente_schema_csv
# Este archivo se genera al ejecutar: python scripts/schema_csv_designer.py
SCHEMA_PATH=../resultados/schema_csv_validado.json

# Directorio donde se guardarán los reportes de carga
# Se creará automáticamente si no existe
OUTPUT_DIR=./output/

# ============================================================================
# OPTIMIZACIÓN DE PERFORMANCE
# ============================================================================

# Tamaño del batch para carga masiva
# Valores recomendados:
#   - Dataset pequeño (< 10K registros): 1000
#   - Dataset mediano (10K - 1M): 5000
#   - Dataset grande (> 1M): 10000
#
# NOTA: Valores muy altos pueden causar problemas de memoria
BATCH_SIZE=1000

# ============================================================================
# NOTAS ADICIONALES
# ============================================================================
#
# ESTRUCTURA ESPERADA DE DIRECTORIOS:
#
# grafo_protesis/subagentes/
# ├── scripts/
# │   ├── csv_neo4j_loader.py      # Script de carga
# │   ├── .env                      # Tu configuración (NO comitear)
# │   ├── .env.csv_loader.example   # Este archivo (ejemplo)
# │   └── output/                   # Reportes generados
# │       └── load_report.json
# ├── csv_data/                     # CSVs fuente
# │   ├── products.csv
# │   ├── suppliers.csv
# │   └── ...
# └── resultados/
#     └── schema_csv_validado.json  # Schema generado
#
# ============================================================================
# VERIFICACIÓN DE CONFIGURACIÓN
# ============================================================================
#
# Para verificar que Neo4j está accesible:
#   neo4j status
#
# Para verificar que los CSVs existen:
#   ls -la ../csv_data/
#
# Para verificar que el schema existe:
#   ls -la ../resultados/schema_csv_validado.json
#
# ============================================================================
