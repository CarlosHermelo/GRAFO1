# ============================================================================
# CONFIGURACIÓN DE BASE DE DATOS VECTORIAL
# ============================================================================
# Este archivo contiene las variables de entorno para el script vectorial_builder.py
#
# INSTRUCCIONES:
# 1. Copia este archivo como .env en el mismo directorio
# 2. Configura tu OPENAI_API_KEY
# 3. Ajusta las rutas y configuraciones según necesites
# 4. Ejecuta: python scripts/vectorial_builder.py

# ============================================================================
# OPENAI CONFIGURATION
# ============================================================================

# Tu API Key de OpenAI (REQUERIDO)
# Obtén tu key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Modelo de embeddings a utilizar
# Opciones:
#   - text-embedding-3-small (Recomendado: Rápido y económico, dimensiones: 1536)
#   - text-embedding-3-large (Mayor precisión, dimensiones: 3072, más costoso)
#   - text-embedding-ada-002 (Modelo anterior, dimensiones: 1536)
EMBEDDING_MODEL=text-embedding-3-small


# ============================================================================
# VECTOR DATABASE CONFIGURATION
# ============================================================================

# Tipo de base de datos vectorial
# Opciones:
#   - chroma (Recomendado: Local, fácil setup, ideal para desarrollo)
#   - qdrant (Para producción, requiere servidor Qdrant ejecutándose)
VECTOR_DB_TYPE=chroma

# Nombre de la colección/base de datos vectorial
# Usa un nombre descriptivo de tu proyecto
VECTOR_DB_NAME=protesis_pami_vectordb

# Ruta donde se almacenará la base de datos vectorial
# Para Chroma: ruta local donde se guardará
# Puede ser relativa al directorio del script o absoluta
VECTOR_DB_PATH=./chroma_db/

# --- SOLO PARA QDRANT (comentar si usas Chroma) ---
# URL del servidor Qdrant
# QDRANT_URL=http://localhost:6333

# API Key de Qdrant (opcional, solo si tu servidor lo requiere)
# QDRANT_API_KEY=


# ============================================================================
# SOURCE DOCUMENTS CONFIGURATION
# ============================================================================

# Directorio donde se encuentran los documentos a procesar
# Puede ser relativa o absoluta
# Por defecto busca en contexto_dominio/ del proyecto
SOURCE_PATH=contexto_dominio/

# Extensiones de archivos a procesar (separadas por coma)
# Soportadas: .pdf, .txt
FILE_EXTENSIONS=.pdf,.txt


# ============================================================================
# CHUNKING OPTIMIZATION (OPCIONAL)
# ============================================================================
# NOTA: Por defecto, el script detecta automáticamente el tipo de documento
# y aplica la estrategia de chunking óptima. Solo configura estos valores
# si quieres sobrescribir el comportamiento automático.

# Tamaño de chunks en caracteres
# Si es 0 o no está configurado, usa detección automática
# Valores recomendados:
#   - Documentos normativos: 800-1200
#   - Documentos técnicos: 600-800
#   - Documentos de análisis: 1000-1500
# CHUNK_SIZE=0

# Overlap entre chunks en caracteres
# Si es 0 o no está configurado, usa detección automática
# Valores recomendados:
#   - Documentos normativos: 150-200
#   - Documentos técnicos: 100-150
#   - Documentos de análisis: 200-250
# CHUNK_OVERLAP=0


# ============================================================================
# EJEMPLOS DE CONFIGURACIÓN
# ============================================================================

# --- Ejemplo 1: Configuración básica local con Chroma ---
# OPENAI_API_KEY=sk-abc123...
# EMBEDDING_MODEL=text-embedding-3-small
# VECTOR_DB_TYPE=chroma
# VECTOR_DB_NAME=mi_proyecto_vectordb
# VECTOR_DB_PATH=./chroma_db/
# SOURCE_PATH=contexto_dominio/
# FILE_EXTENSIONS=.pdf,.txt

# --- Ejemplo 2: Usando Qdrant en servidor local ---
# OPENAI_API_KEY=sk-abc123...
# EMBEDDING_MODEL=text-embedding-3-small
# VECTOR_DB_TYPE=qdrant
# VECTOR_DB_NAME=mi_proyecto_vectordb
# QDRANT_URL=http://localhost:6333
# SOURCE_PATH=contexto_dominio/
# FILE_EXTENSIONS=.pdf,.txt

# --- Ejemplo 3: Solo procesar PDFs con chunking manual ---
# OPENAI_API_KEY=sk-abc123...
# EMBEDDING_MODEL=text-embedding-3-large
# VECTOR_DB_TYPE=chroma
# VECTOR_DB_NAME=documentos_normativos
# VECTOR_DB_PATH=./vectordb/
# SOURCE_PATH=/ruta/absoluta/documentos/
# FILE_EXTENSIONS=.pdf
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
