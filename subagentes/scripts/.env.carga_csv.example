# ============================================================================
# CARGADOR DE CSVs A NEO4J CONFIGURATION
# ============================================================================
# Este archivo contiene las variables de entorno para el script
# csv_to_neo4j.py
#
# INSTRUCCIONES:
# 1. Copia este archivo como .env en el mismo directorio
# 2. Configura tus credenciales de Neo4j
# 3. Asegúrate de tener el schema validado
# 4. Verifica que los CSVs estén en la subcarpeta CSV_DIR
# 5. Ejecuta: python scripts/csv_to_neo4j.py

# ============================================================================
# NEO4J CONNECTION
# ============================================================================

# URI de conexión a Neo4j
# Formato: bolt://host:puerto
# Local: bolt://localhost:7687
# Remoto: bolt://192.168.1.100:7687
# Aura: neo4j+s://xxxxx.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687

# Usuario de Neo4j (por defecto: neo4j)
NEO4J_USER=neo4j

# Contraseña de Neo4j (REQUERIDO)
# IMPORTANTE: Cambia esto por tu contraseña real
NEO4J_PASSWORD=your-password-here


# ============================================================================
# ARCHIVOS CSV
# ============================================================================

# Directorio/subcarpeta donde están los archivos CSV
# Estos son los MISMOS CSVs usados para diseñar el schema
# Debe coincidir con CSV_DIR del schema_csv_designer
#
# Estructura esperada:
#   proyecto/
#   ├── csv_data/              ← Esta subcarpeta
#   │   ├── products.csv
#   │   ├── suppliers.csv
#   │   └── customers.csv
#   ├── scripts/
#   │   ├── csv_to_neo4j.py
#   │   └── .env
#   └── resultados/
#       └── schema_csv_validado.json
CSV_DIR=./csv_data/


# ============================================================================
# SCHEMA VALIDADO
# ============================================================================

# Ruta al schema validado generado por schema_csv_designer.py
# Este archivo contiene la estructura del grafo a crear
SCHEMA_PATH=resultados/schema_csv_validado.json


# ============================================================================
# MÉTODO DE CARGA
# ============================================================================

# Método para cargar los CSVs a Neo4j
# Opciones:
#   - load_csv: Usa LOAD CSV de Neo4j (Recomendado - Más rápido)
#   - batch: Usa Python driver con carga batch (Más flexible)
#
# LOAD CSV:
#   ✅ Muy rápido (optimizado por Neo4j)
#   ✅ Ideal para < 1M filas
#   ❌ Requiere CSVs en directorio import/ de Neo4j
#
# Batch:
#   ✅ Funciona con CSVs en cualquier ubicación
#   ✅ Mejor control de errores
#   ❌ Más lento
LOAD_METHOD=load_csv


# ============================================================================
# NEO4J IMPORT DIRECTORY (Solo para LOAD_METHOD=load_csv)
# ============================================================================

# Directorio import/ de Neo4j donde deben estar los CSVs
# Si no se especifica, el script intentará detectarlo automáticamente
#
# Ubicaciones típicas:
# - Neo4j Desktop (macOS):
#   ~/Library/Application Support/Neo4j Desktop/Application/relate-data/dbmss/dbms-xxxxx/import/
#
# - Neo4j Desktop (Windows):
#   C:\Users\<user>\AppData\Local\Neo4j\Relate\Data\dbmss\dbms-xxxxx\import\
#
# - Neo4j Desktop (Linux):
#   ~/.config/Neo4j Desktop/Application/relate-data/dbmss/dbms-xxxxx/import/
#
# - Neo4j standalone:
#   /path/to/neo4j/import/
#
# - Neo4j Docker:
#   /var/lib/neo4j/import/
#
# El script puede copiar automáticamente los CSVs a este directorio
NEO4J_IMPORT_DIR=


# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# Tamaño de batch (Solo para LOAD_METHOD=batch)
# Cantidad de filas a procesar en cada transacción
# Valores típicos:
#   - 500-1000: Datasets pequeños
#   - 1000-5000: Datasets medianos (Recomendado)
#   - 5000-10000: Datasets grandes
# Más alto = Más rápido pero más memoria
BATCH_SIZE=1000


# ============================================================================
# OPCIONES AVANZADAS
# ============================================================================

# Limpiar toda la base de datos antes de cargar
# ADVERTENCIA: Esto borrará TODOS los nodos y relaciones existentes
# Opciones: true, false
CLEAR_DATABASE=false

# Continuar si falta un archivo CSV mencionado en el schema
# Si true: Muestra advertencia y continúa
# Si false: Detiene la ejecución
# Opciones: true, false
CONTINUE_ON_MISSING_CSV=false

# Modo verbose - Muestra información detallada durante la carga
# Opciones: true, false
VERBOSE=true

# Crear índices automáticamente para propiedades frecuentes
# (Además de los constraints para PKs)
# Opciones: true, false
CREATE_INDEXES=false


# ============================================================================
# EJEMPLOS DE CONFIGURACIÓN
# ============================================================================

# --- Ejemplo 1: Configuración básica local ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=mypassword123
# CSV_DIR=./csv_data/
# SCHEMA_PATH=resultados/schema_csv_validado.json
# LOAD_METHOD=load_csv

# --- Ejemplo 2: Neo4j Docker ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=dockerpassword
# CSV_DIR=./csv_data/
# LOAD_METHOD=load_csv
# NEO4J_IMPORT_DIR=/var/lib/neo4j/import/

# --- Ejemplo 3: Neo4j Aura (Cloud) ---
# NEO4J_URI=neo4j+s://xxxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=aura-generated-password
# CSV_DIR=./csv_data/
# LOAD_METHOD=batch  # Aura no permite acceso a import/
# BATCH_SIZE=2000

# --- Ejemplo 4: Dataset grande con batch ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=mypassword
# CSV_DIR=./csv_data/
# LOAD_METHOD=batch
# BATCH_SIZE=5000
# VERBOSE=true

# --- Ejemplo 5: Recrear grafo desde cero ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=mypassword
# CSV_DIR=./csv_data/
# CLEAR_DATABASE=true  # ⚠️ Borrará todo
# LOAD_METHOD=load_csv


# ============================================================================
# PREPARACIÓN ANTES DE EJECUTAR
# ============================================================================

# Paso 1: Verificar que Neo4j esté corriendo
#   - Neo4j Desktop: Panel de control → Start
#   - Docker: docker ps | grep neo4j
#   - Aura: Verificar en dashboard

# Paso 2: Verificar conexión
#   python -c "from neo4j import GraphDatabase; driver = GraphDatabase.driver('bolt://localhost:7687', auth=('neo4j', 'password')); driver.verify_connectivity(); print('OK')"

# Paso 3: Verificar que el schema validado existe
#   ls resultados/schema_csv_validado.json

# Paso 4: Verificar que los CSVs estén en CSV_DIR
#   ls csv_data/
#   Deberías ver los archivos mencionados en el schema

# Paso 5: (Opcional) Verificar CSVs antes de cargar
#   python -c "import pandas as pd; df = pd.read_csv('csv_data/products.csv'); print(df.head()); print(f'Filas: {len(df)}')"


# ============================================================================
# SOLUCIÓN DE PROBLEMAS COMUNES
# ============================================================================

# Problema: "Authentication failed"
# Solución: Verifica NEO4J_USER y NEO4J_PASSWORD
#   - Neo4j Desktop: Ver contraseña en settings
#   - Neo4j Aura: Usar contraseña generada al crear la instancia

# Problema: "Could not connect to Neo4j"
# Solución: Verifica que Neo4j esté corriendo y NEO4J_URI sea correcto
#   - Prueba abrir Neo4j Browser: http://localhost:7474

# Problema: "CSVs must be in import directory"
# Solución (Opción 1): Especifica NEO4J_IMPORT_DIR
# Solución (Opción 2): Cambia LOAD_METHOD=batch

# Problema: "Schema file not found"
# Solución: Ejecuta primero: python scripts/schema_csv_designer.py

# Problema: "CSV file not found"
# Solución: Verifica que los CSVs estén en CSV_DIR y coincidan con el schema
#   cat resultados/schema_csv_validado.json | grep source_file

# Problema: Carga muy lenta
# Solución (Opción 1): Usa LOAD_METHOD=load_csv (más rápido)
# Solución (Opción 2): Aumenta BATCH_SIZE
# Solución (Opción 3): Verifica que existan constraints (mejoran MERGE)


# ============================================================================
# NOTAS IMPORTANTES
# ============================================================================

# 1. Este script lee el SCHEMA previamente generado
#    No diseña el schema, solo carga datos según el schema existente

# 2. El script es IDEMPOTENTE
#    Puedes ejecutarlo múltiples veces (usa MERGE, no CREATE)
#    No creará duplicados

# 3. ORDEN de carga (automático):
#    - Constraints (para PKs)
#    - Nodos (todos los tipos)
#    - Relaciones (después de nodos)

# 4. Los CSVs deben ser los MISMOS usados para diseñar el schema
#    Si modificas los CSVs, regenera el schema primero

# 5. Neo4j debe tener suficiente memoria para el dataset
#    Ver: Neo4j Desktop → Settings → dbms.memory.heap.max_size

# 6. Backup recomendado antes de cargar datos importantes:
#    neo4j-admin dump --database=neo4j --to=/path/backup.dump


# ============================================================================
# VALIDACIÓN POST-CARGA
# ============================================================================

# Después de ejecutar el script, verifica en Neo4j Browser (http://localhost:7474):

# Ver tipos de nodos:
#   CALL db.labels()

# Ver tipos de relaciones:
#   CALL db.relationshipTypes()

# Contar nodos:
#   MATCH (n) RETURN labels(n), count(n)

# Contar relaciones:
#   MATCH ()-[r]->() RETURN type(r), count(r)

# Ver muestra de datos:
#   MATCH (n)-[r]->(m) RETURN n, r, m LIMIT 25

# Verificar constraints:
#   SHOW CONSTRAINTS
