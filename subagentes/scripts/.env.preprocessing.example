# ============================================================================
# GRAPH PREPROCESSING CONFIGURATION
# ============================================================================
# Este archivo contiene las variables de entorno para el script de
# pre-procesamiento de grafo (graph_preprocessing.py)
#
# INSTRUCCIONES:
# 1. Copia este archivo como .env en el mismo directorio
# 2. Configura las credenciales de Neo4j
# 3. Configura tu OPENAI_API_KEY (opcional, solo para resúmenes)
# 4. Ajusta los algoritmos y parámetros según necesites
# 5. Ejecuta: python scripts/graph_preprocessing.py

# ============================================================================
# NEO4J CONFIGURATION
# ============================================================================

# URI de conexión a Neo4j (REQUERIDO)
# Opciones:
#   - bolt://localhost:7687 (Neo4j local)
#   - neo4j://localhost:7687 (Neo4j 4.x+)
#   - bolt://tu-servidor.com:7687 (Neo4j remoto)
NEO4J_URI=bolt://localhost:7687

# Usuario de Neo4j (por defecto: neo4j)
NEO4J_USER=neo4j

# Contraseña de Neo4j (REQUERIDO)
NEO4J_PASSWORD=your-neo4j-password


# ============================================================================
# OPENAI CONFIGURATION (OPCIONAL - Solo para resúmenes de comunidades)
# ============================================================================

# Tu API Key de OpenAI
# Solo necesario si GENERATE_SUMMARIES=true
# Obtén tu key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Modelo de lenguaje para generar resúmenes de comunidades
# Opciones:
#   - gpt-4 (Recomendado: Mejor calidad)
#   - gpt-4-turbo (Rápido y económico)
#   - gpt-3.5-turbo (Más económico, menor calidad)
LLM_MODEL=gpt-4


# ============================================================================
# COMMUNITY DETECTION ALGORITHM
# ============================================================================

# Algoritmo de detección de comunidades a usar
# Opciones:
#   - louvain (Recomendado: Mejor balance calidad/velocidad)
#   - labelPropagation (Más rápido, menos preciso, bueno para grafos grandes)
#   - wcc (Solo componentes conectados, muy rápido, determínístico)
COMMUNITY_ALGORITHM=louvain


# ============================================================================
# CENTRALITY METRICS
# ============================================================================

# Calcular PageRank (importancia/autoridad de nodos)
# Útil para: Rankear resultados, priorizar fuentes
# Velocidad: Medio
COMPUTE_PAGERANK=true

# Calcular Betweenness Centrality (nodos puente)
# Útil para: Identificar conectores clave
# Velocidad: Lento (deshabilitado por defecto para grafos grandes)
COMPUTE_BETWEENNESS=true

# Calcular Degree Centrality (cantidad de conexiones)
# Útil para: Identificar hubs
# Velocidad: Rápido
COMPUTE_DEGREE=true


# ============================================================================
# COMMUNITY SUMMARIES
# ============================================================================

# Generar resúmenes de comunidades con LLM
# Si es true: Usa OpenAI para generar resúmenes descriptivos
# Si es false: Solo detecta comunidades, no genera resúmenes
# Requiere: OPENAI_API_KEY configurada
# Costo: ~$0.005-0.01 USD por comunidad (con GPT-4)
GENERATE_SUMMARIES=true

# Cantidad máxima de comunidades a resumir
# Limita costos de OpenAI
# Solo se resumen las N comunidades más grandes
# Si hay 50 comunidades y MAX=20, solo se resumen las 20 más grandes
MAX_COMMUNITIES_TO_SUMMARIZE=20


# ============================================================================
# ADVANCED CONFIGURATION (OPCIONAL)
# ============================================================================

# Timeout para operaciones de Neo4j en segundos
# Aumentar si tienes grafos muy grandes
# NEO4J_TIMEOUT=300

# Habilitar modo verbose (más logs de debug)
# VERBOSE=false

# Nombre del grafo proyectado en GDS
# Si cambias esto, asegúrate de que no colisione con otros grafos
# GDS_GRAPH_NAME=preprocessGraph


# ============================================================================
# EJEMPLOS DE CONFIGURACIÓN
# ============================================================================

# --- Ejemplo 1: Configuración básica sin resúmenes (gratis) ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=tu-password
# COMMUNITY_ALGORITHM=louvain
# COMPUTE_PAGERANK=true
# COMPUTE_BETWEENNESS=false
# COMPUTE_DEGREE=true
# GENERATE_SUMMARIES=false

# --- Ejemplo 2: Configuración completa con resúmenes ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=tu-password
# OPENAI_API_KEY=sk-abc123...
# LLM_MODEL=gpt-4
# COMMUNITY_ALGORITHM=louvain
# COMPUTE_PAGERANK=true
# COMPUTE_BETWEENNESS=true
# COMPUTE_DEGREE=true
# GENERATE_SUMMARIES=true
# MAX_COMMUNITIES_TO_SUMMARIZE=20

# --- Ejemplo 3: Optimizado para grafos grandes (velocidad) ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=tu-password
# COMMUNITY_ALGORITHM=labelPropagation  # Más rápido
# COMPUTE_PAGERANK=true
# COMPUTE_BETWEENNESS=false  # Lento, deshabilitar
# COMPUTE_DEGREE=true
# GENERATE_SUMMARIES=false  # Ahorrar tiempo y costos

# --- Ejemplo 4: Solo detección de componentes desconectados ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=tu-password
# COMMUNITY_ALGORITHM=wcc  # Solo componentes conectados
# COMPUTE_PAGERANK=false
# COMPUTE_BETWEENNESS=false
# COMPUTE_DEGREE=true
# GENERATE_SUMMARIES=false


# ============================================================================
# NOTAS IMPORTANTES
# ============================================================================

# 1. REQUISITO: Neo4j debe tener el plugin Graph Data Science (GDS) instalado
#    - Neo4j Desktop: Plugins → Graph Data Science → Install
#    - Neo4j Server: https://neo4j.com/docs/graph-data-science/current/installation/
#    - Verificar: RETURN gds.version()

# 2. El script es IDEMPOTENTE: puedes re-ejecutarlo sin problemas
#    Limpia automáticamente resultados de procesamientos anteriores

# 3. GENERATE_SUMMARIES=true consume tokens de OpenAI
#    Costo estimado: ~$0.10-0.20 USD por 20 comunidades (con GPT-4)

# 4. COMPUTE_BETWEENNESS=true puede ser LENTO en grafos grandes (>10K nodos)
#    Considera deshabilitarlo si no lo necesitas

# 5. Los resultados se almacenan como propiedades en los nodos:
#    - n.community_id (ID de la comunidad)
#    - n.community_name (nombre de la comunidad)
#    - n.pagerank (si COMPUTE_PAGERANK=true)
#    - n.betweenness (si COMPUTE_BETWEENNESS=true)
#    - n.degree (si COMPUTE_DEGREE=true)

# 6. También se crean nodos :Community con resúmenes:
#    - Community.id
#    - Community.name
#    - Community.summary
#    - Community.node_count

# 7. Después de ejecutar este script, el asistente GraphRAG podrá usar
#    la estrategia 5 (Comunidades + Resúmenes) de forma eficiente
