
OPENAI_API_KEY=sk-proj-TU_API_KEY_AQUI

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=tu_password_aqui

LLM_MODEL=gpt-4-turbo

TEMPERATURE=0

# Nombre de la base de datos (dejar vacío para default)
NEO4J_DATABASE=neo4j

# === Configuración para Ciclo TEXTO ===
# Tamaño de los chunks para procesamiento de documentos
CHUNK_SIZE=1000

# Superposición entre chunks (en caracteres)
CHUNK_OVERLAP=200

# Directorio donde se encuentran los documentos de texto
# Relativo al directorio del proyecto
TEXT_DIR=./import_data/pdf

# Modelo de embeddings de OpenAI
# Opciones: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
EMBEDDING_MODEL=text-embedding-3-small

# Dimensión de los embeddings
# text-embedding-3-small: 1536
# text-embedding-3-large: 3072
EMBEDDING_DIMENSION=1536

# === Configuración para Ciclo CSV ===
# Directorio donde se encuentran los archivos CSV
# Relativo al directorio del proyecto
CSV_DIR=./import_data/csv/

# Delimitador de CSV (por defecto ",")
CSV_DELIMITER=,

# Encoding de los archivos CSV
CSV_ENCODING=utf-8

# === Rutas de Salida ===
# Directorio para resultados generados
OUTPUT_DIR=./resultados/


LOG_DIR=./logs/

# === Opciones de Pre-procesamiento (Ciclo TEXTO) ===
# Estrategia de pre-procesamiento:
# - basic: Solo crea el grafo básico
# - communities_summaries: Detecta comunidades y genera resúmenes (recomendado para GraphRAG)
PREPROCESSING_STRATEGY=communities_summaries

# Algoritmo de detección de comunidades
# Opciones: louvain, label_propagation, leiden
COMMUNITY_ALGORITHM=louvain

# Nivel de resolución para detección de comunidades (0.5 - 2.0)
# Valores más altos = más comunidades pequeñas
COMMUNITY_RESOLUTION=1.0

# === Opciones de Depuración (Ciclo TEXTO) ===
# Umbral de similitud para deduplicación de entidades (0.0 - 1.0)
# Valores más altos = menos fusiones (más estricto)
DEDUPLICATION_THRESHOLD=0.85

# Método de similitud: cosine, jaccard, levenshtein
SIMILARITY_METHOD=cosine

# === Configuración del Asistente GraphRAG ===
# Número máximo de nodos a recuperar en búsquedas
MAX_RETRIEVAL_NODES=20

# Número de comunidades a considerar en búsqueda global
MAX_COMMUNITIES=10

# Modo de búsqueda por defecto: local, global, hybrid
DEFAULT_SEARCH_MODE=hybrid

# === Configuración de Logging ===
# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Guardar logs en archivo
LOG_TO_FILE=true

# === Opciones Avanzadas ===
# Número de workers para procesamiento paralelo
NUM_WORKERS=4

# Tamaño de batch para operaciones masivas en Neo4j
BATCH_SIZE=100

# Timeout para consultas Neo4j (en segundos)
NEO4J_TIMEOUT=300

# === Configuración de Caché ===
# Habilitar caché de embeddings
ENABLE_EMBEDDING_CACHE=true

# Directorio de caché
CACHE_DIR=./.cache/

# === Variables Específicas por Agente ===
# (Opcional) Sobrescribir configuración por agente específico

# Agente de Objetivo
# OBJETIVO_MAX_ITERATIONS=3

# Agente de Ingesta
# INGESTA_BATCH_SIZE=50

# Agente de Depuración
# DEPURACION_DRY_RUN=false

# === Configuración de Desarrollo ===
# Modo debug (muestra información adicional)
DEBUG=false

# Modo de prueba (no hace cambios permanentes)
DRY_RUN=false

# ============================================================
# NOTAS IMPORTANTES:
# ============================================================
#
# 1. Variables REQUERIDAS (mínimas para empezar):
#    - OPENAI_API_KEY
#    - LLM_MODEL
#    - NEO4J_URI
#    - NEO4J_USER
#    - NEO4J_PASSWORD
#
# 2. Para Ciclo TEXTO, también necesitas:
#    - CHUNK_SIZE
#    - CHUNK_OVERLAP
#    - EMBEDDING_MODEL
#    - EMBEDDING_DIMENSION
#
# 3. Para Ciclo CSV, también necesitas:
#    - CSV_DIR
#
# 4. El orquestador validará estas variables al iniciar
#
# 5. Puedes verificar la configuración ejecutando:
#    python scripts/orquestador.py
#    y seleccionando la opción "4. Verificar configuración"
#
# ============================================================
